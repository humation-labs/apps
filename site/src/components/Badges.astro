---
import { platformLabel, PRICING_LABELS } from '../lib/constants';

interface Props {
  platforms: string[];
  pricing?: string;
}

const { platforms, pricing } = Astro.props;
---

<div class="badges">
  {platforms.map((platform) => <span class="badge">{platformLabel(platform)}</span>)}
  {
    pricing ? (
      <span class="badge">{PRICING_LABELS[pricing as keyof typeof PRICING_LABELS] ?? pricing}</span>
    ) : null
  }
</div>
