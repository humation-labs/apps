<header class="site-header">
  <div class="wrap site-header-inner">
    <a class="brand" href="/">
      <img
        class="brand-logo brand-logo-light"
        src="/logo_humation.svg"
        alt="Humation"
        width="102"
        height="16"
      />
      <img
        class="brand-logo brand-logo-dark"
        src="/logo_humation_dk.svg"
        alt=""
        width="102"
        height="16"
      />
      <span class="brand-wordmark">Apps</span>
    </a>
    <nav class="header-nav" aria-label="Site">
      <a href="https://humation.app">humation.app</a>
      <button type="button" class="btn btn-add" data-copy-prompt data-label="Add your app">
        Add your app
      </button>
    </nav>
  </div>
</header>
