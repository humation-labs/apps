---
import Layout from '../../layouts/Layout.astro';
import AppCard from '../../components/AppCard.astro';
import { categoryLabel } from '../../lib/constants';
import { categoryCounts, listingsByCategory } from '../../lib/listings';

export async function getStaticPaths() {
  const categories = await categoryCounts();
  return categories.map(({ category }) => ({ params: { category } }));
}

const category = Astro.params.category ?? '';
const title = categoryLabel(category);
const apps = await listingsByCategory(category);
const countLabel = `${apps.length} ${apps.length === 1 ? 'app' : 'apps'}`;
---

<Layout
  title={title}
  description={`${countLabel} in ${title} on Humation Apps.`}
  canonicalPath={`/category/${category}`}
>
  <div class="wrap page">
    <p class="crumb"><a href="/">Apps</a> / {title}</p>
    <h1 class="page-title">{title}</h1>
    <p class="lede" style="margin: 0 0 1.5rem; color: var(--text-muted);">{countLabel}</p>
    <div class="card-grid">
      {apps.map((app) => <AppCard app={app} />)}
    </div>
  </div>
</Layout>
