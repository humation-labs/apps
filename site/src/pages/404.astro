---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Not found"
  description="This page is not in the Humation Apps catalog."
  canonicalPath="/404"
>
  <div class="wrap page">
    <h1 class="page-title">Not found</h1>
    <p class="lede" style="color: var(--text-muted); max-width: 32rem;">
      That page is not in the catalog. Head back to the store and browse apps built with Humation.
    </p>
    <p style="margin-top: 1.25rem;">
      <a class="btn btn-primary" href="/">Back to Apps</a>
    </p>
  </div>
</Layout>
